rules_version = '2';
// Reglas de seguridad de la agenda online · Valênia Simões
// Copiar en Firebase → Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    // Emails de las cuentas de la clínica que pueden ver y gestionar la agenda.
    function esClinica() {
      return request.auth != null
        && request.auth.token.email in ['CAMBIAR@correo-de-la-clinica.com'];
    }
    function slotValido(d, id) {
      return d.centro in ['corella', 'logrono']
        && d.prof in ['c1', 'c2', 'c3', 'l1', 'l2', 'l3']
        && d.fecha is string && d.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.hora is string && d.hora.matches('^[0-9]{2}:[0-9]{2}$')
        && id == d.fecha + '_' + d.hora + '_' + d.prof;
    }

    // Horas ocupadas: cualquiera puede verlas (no llevan datos personales).
    // Una clienta solo puede crear una hora nueva (nunca pisar otra) junto con su cita.
    match /ocupado/{id} {
      allow read: if true;
      allow create: if esClinica() || (
        slotValido(request.resource.data, id)
        && request.resource.data.tipo == 'cita'
        && request.resource.data.keys().hasOnly(['centro', 'fecha', 'hora', 'prof', 'tipo'])
        && existsAfter(/databases/$(database)/documents/citas/$(id))
      );
      allow update, delete: if esClinica();
    }

    // Citas con datos personales: solo la clínica puede leerlas.
    match /citas/{id} {
      allow read, update, delete: if esClinica();
      allow create: if esClinica() || (
        slotValido(request.resource.data, id)
        && request.resource.data.origen == 'web'
        && request.resource.data.privacidad == true
        && request.resource.data.keys().hasOnly(['centro', 'fecha', 'hora', 'prof', 'servicio', 'nombre', 'telefono', 'notas', 'origen', 'privacidad', 'creada'])
        && request.resource.data.nombre is string && request.resource.data.nombre.size() > 1 && request.resource.data.nombre.size() <= 80
        && request.resource.data.telefono is string && request.resource.data.telefono.size() <= 30
        && request.resource.data.servicio is string && request.resource.data.servicio.size() <= 80
        && request.resource.data.notas is string && request.resource.data.notas.size() <= 500
        && request.resource.data.creada == request.time
        && getAfter(/databases/$(database)/documents/ocupado/$(id)).data.tipo == 'cita'
      );
    }
  }
}
